# LexPortal Production Environment Variables Template
# Copy this to .env.prod and fill in the secrets

# Database
POSTGRES_USER=lexadmin
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=lexportal_prod

# Security
SECRET_KEY=generate_a_long_random_string_for_encryption
JWT_SECRET=generate_another_random_string_for_jwt
ENCRYPTION_KEY=32_character_base64_key_for_pii_data

# API Keys
GEMINI_API_KEY=your_google_ai_key
MOLLIE_API_KEY=your_mollie_live_key
GROQ_API_KEY=your_groq_key
GITHUB_TOKEN=your_github_pat_for_reporting

# Domain & URLs
# Without trailing slash!
APP_BASE_URL=https://lexportal.pl
BACKEND_URL=http://backend:8000

# Environment
ENVIRONMENT=PRODUCTION
DEBUG=False

#new